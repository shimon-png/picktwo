# ─── Required ──────────────────────────────────────────────────────────────
# Postgres. On Vercel, add Neon from the Storage tab and these are set for you.
DATABASE_URL=postgresql://postgres@localhost:5432/picktwo
DATABASE_URL_UNPOOLED=postgresql://postgres@localhost:5432/picktwo

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# ─── Sign-in ───────────────────────────────────────────────────────────────
# Email magic links + all transactional email (https://resend.com).
# Without it, sign-in links are printed to the server log (dev only).
AUTH_RESEND_KEY=
EMAIL_FROM="PickTwo <hello@yourdomain.com>"

# Optional Google sign-in
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Demo login: sign in with just an email, no verification.
# Handy for local dev and a private preview. NEVER leave on for a public launch.
DEV_LOGIN=false

# ─── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated emails that get the admin panel at /admin
ADMIN_EMAILS=you@example.com
# Vercel Cron sends this automatically as a Bearer token
CRON_SECRET=

# ─── Optional services ─────────────────────────────────────────────────────
# Image uploads (Vercel → Storage → Blob). Without it, images are stored inline (≤1.5 MB).
BLOB_READ_WRITE_TOKEN=
# Shared rate limiting (Vercel → Storage → Upstash Redis). Without it, in-memory per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Automated image moderation: none | openai
MODERATION_PROVIDER=none
OPENAI_API_KEY=
