# ─── Required ──────────────────────────────────────────────────────────────
# Postgres. On Vercel, add Neon from the Storage tab and these are set for you.
DATABASE_URL=postgresql://postgres@localhost:5432/picktwo
DATABASE_URL_UNPOOLED=postgresql://postgres@localhost:5432/picktwo

# Auth.js secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# ─── Sign-in ───────────────────────────────────────────────────────────────
# Email sign-in codes + all transactional email (https://resend.com).
# EMAIL_FROM must be on a domain verified in Resend, or codes won't arrive.
# Without a key, codes are printed to the server log (and shown on screen when DEV_LOGIN=true).
AUTH_RESEND_KEY=
EMAIL_FROM="PickTwo <hello@yourdomain.com>"

# Optional Google sign-in
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Dev mode: when there's no AUTH_RESEND_KEY, show the 6-digit sign-in code on screen.
# Anyone can then sign in as ANY email (admins included). Local dev / tests only, NEVER in production.
DEV_LOGIN=false

# ─── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated emails that get the admin panel at /admin
ADMIN_EMAILS=you@example.com
# Optional: email new contact-form messages here (needs AUTH_RESEND_KEY). Inbox is always at /admin/messages.
CONTACT_ALERT_EMAIL=
# Vercel Cron sends this automatically as a Bearer token
CRON_SECRET=

# ─── Optional services ─────────────────────────────────────────────────────
# Image uploads (Vercel → Storage → Blob). Without it, images are stored inline (≤1.5 MB).
BLOB_READ_WRITE_TOKEN=
# Shared rate limiting (Vercel → Storage → Upstash Redis). Without it, in-memory per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Automated nudity/violence screening of uploads (OpenAI omni-moderation, free).
# Screening runs whenever OPENAI_API_KEY is set, unless MODERATION_PROVIDER=none.
MODERATION_PROVIDER=openai
OPENAI_API_KEY=
# Known-CSAM hash matching (Microsoft PhotoDNA Cloud Service; apply as an organisation).
PHOTODNA_KEY=
# PHOTODNA_ENDPOINT=   # optional override
# Where flag / auto-screen alerts go (needs AUTH_RESEND_KEY). Falls back to CONTACT_ALERT_EMAIL.
MODERATION_ALERT_EMAIL=
